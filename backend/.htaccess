<IfModule mod_rewrite.c>
    RewriteEngine On

    # Deny access to sensitive files and folders
    RewriteRule ^(\.env|\.git) - [F,L]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor) - [F,L]
    RewriteRule ^(artisan|composer\.json|composer\.lock|package\.json) - [F,L]

    # Rewrite all requests to public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
